# bff (auth + SSE bridge) env — copy to bff.env and fill in. Server-only, gitignored.
#
# Google OAuth Web client ID the chat UI signs in with (audience for ID tokens).
# Must match the client the web UI uses.
GOOGLE_CLIENT_ID=245835837222-qa1htil1kpgaiaq0u0ep9ts5vpls6hqa.apps.googleusercontent.com
# Comma-separated allowed email domains. Empty = allow any verified Google account.
ALLOWED_DOMAINS=leapswitch.com,leapswitchnetwork.com
# Upstream Hermes API server (private network name:port).
HERMES_URL=http://hermes:8642
# Internal shared secret — MUST equal API_SERVER_KEY in hermes.env.
HERMES_API_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
# Max seconds to wait on an upstream agent turn (agents can be slow).
REQUEST_TIMEOUT=600
# Revenue-recovery Postgres (read-only use: WhatsApp disconnect stats for the
# login banner). MUST match the DATABASE_URL / password in hermes.env + db.env.
DATABASE_URL=postgresql://moneyshot:REPLACE_WITH_DB_PASSWORD@db:5432/moneyshot
