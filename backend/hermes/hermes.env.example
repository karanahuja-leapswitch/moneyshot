# Hermes container env — copy to hermes.env and fill in. Server-only, gitignored.
#
# Internal shared secret between the bff and hermes. Must equal HERMES_API_KEY
# in bff.env. Generate with: openssl rand -hex 32
API_SERVER_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
#
# Optional: if you prefer keeping the model key out of config.yaml, uncomment
# and set it here instead of the `api_key:` line in config.yaml.
# CUSTOM_API_KEY=REPLACE_WITH_YOUR_MODEL_API_KEY
